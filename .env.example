# GEMINI_API_KEY: Optional build-time fallback for Gemini AI API calls.
# Users can also paste, save, or delete their Google Gemini API key directly inside the Moko Settings screen.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# KALPA_API_KEY: Optional build-time key for Kalpa Labs Neural Voice TTS (kalpalabs.ai).
# Configure securely via the Secrets panel in AI Studio or inside the Moko Settings screen.
KALPA_API_KEY=sk-live-16d737b9d22e975f70efdebf99f3d053d85e488d87f18192
